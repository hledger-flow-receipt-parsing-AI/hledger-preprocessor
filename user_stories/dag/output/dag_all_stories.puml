    out_duplicate_blocked [label="BLOCKED\nalready linked", shape=diamond, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="CSV transaction already claimed by another receipt"];
    out_skip_cash [label="SKIP\nno CSV for wallet", shape=diamond, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="Cash receipt, no bank CSV to match against"];
    out_swap_dd_mm [label="SWAP DD/MM\n01-05 -> 05-01", shape=diamond, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Auto-retry with day/month swapped"];
