@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config_accounts {
    label="Account Configuration";
    style=filled; fillcolor="#E3F2FD";
    rank=same;
    acct_btc_wallet [label="BTC digital\nwallet", shape=box3d, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="BTC digital wallet / exchange"];
    acct_eur_wallet [label="EUR physical\nwallet", shape=box3d, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="EUR cash wallet — no CSV import"];
    acct_gbp_wallet [label="GBP physical\nwallet", shape=box3d, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="GBP cash wallet — foreign currency"];
    acct_gold_wallet [label="GOLD physical\nwallet", shape=box3d, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="GOLD physical asset wallet"];
    acct_silver_wallet [label="SILVER physical\nwallet", shape=box3d, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="SILVER physical asset wallet"];
    acct_triodos_csv [label="Triodos checking\n(EUR CSV)", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos checking account — imports from CSV"];
  }

  subgraph cluster_config_dir_paths {
    label="Directory Paths";
    style=filled; fillcolor="#BBDEFB";
    rank=same;
    dirp_default [label="Default dir paths", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard directory layout: import/{holder}/{bank}/{type}/{year}/"];
  }

  subgraph cluster_config_file_names {
    label="Filename Convention";
    style=filled; fillcolor="#90CAF9";
    rank=same;
    fnames_default [label="Default filenames", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard filename conventions for CSV, rules, and journal files"];
  }

  subgraph cluster_config_categorisation {
    label="Categorisation Config";
    style=filled; fillcolor="#64B5F6";
    rank=same;
    catcfg_default [label="Default categorisation", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard categorisation settings from config.yaml"];
  }

  subgraph cluster_config_matching_algo {
    label="Matching Algo Config";
    style=filled; fillcolor="#42A5F5";
    rank=same;
    malgo_default [label="Default matching algo", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard matching algorithm settings from config.yaml"];
  }

  subgraph cluster_categories {
    label="Categories";
    style=filled; fillcolor="#E8F5E9";
    rank=same;
    cat_basic [label="basic categories", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="groceries:{ekoplaza,supermarket}, repairs:{bike}, withdrawl:{euro:{pound}}"];
  }

  subgraph cluster_matching_cfg {
    label="Matching Parameters";
    style=filled; fillcolor="#FFF3E0";
    rank=same;
    match_default [label="default (±2d, exact)", shape=component, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="days:2, amount_range:0, days_month_swap:true"];
  }

  subgraph cluster_start_journal {
    label="Starting Journal";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    start_2024_1000eur [label="2024: 1000 EUR", shape=note, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Opening balance: Assets:Triodos:Checking 1000 EUR"];
  }

  subgraph cluster_csv_txn {
    label="Bank CSV Transactions";
    style=filled; fillcolor="#E0F7FA";
    rank=same;
    csv_atm_gbp_11750 [label="Triodos -117.50 EUR\n2025-01-15 ATM London", shape=cylinder, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Foreign ATM withdrawal: 100 GBP * 1.175"];
    csv_ekoplaza_4217_jan15 [label="Triodos -42.17 EUR\n2025-01-15 Ekoplaza", shape=cylinder, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="Debit card purchase at Ekoplaza, exact date match"];
  }

  subgraph cluster_receipt_img {
    label="Receipt Images";
    style=filled; fillcolor="#FBE9E7";
    rank=same;
    img_atm_gbp [label="atm_london.jpg", shape=folder, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="ATM withdrawal slip, 100 GBP"];
    img_ekoplaza_card [label="ekoplaza_card.jpg", shape=folder, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="Ekoplaza receipt, paid by card"];
  }

  subgraph cluster_receipt_lbl {
    label="Receipt Labels (JSON)";
    style=filled; fillcolor="#FCE4EC";
    rank=same;
    lbl_atm_100gbp [label="atm_100gbp\nGBP 100 withdrawal", shape=tab, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Triodos account, GBP withdrawal receipt"];
    lbl_ekoplaza_card_eur [label="ekoplaza_card\nEUR 42.17 card", shape=tab, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="Triodos account, 2025-01-15, groceries:ekoplaza"];
  }

  subgraph cluster_matching_out {
    label="Matching Outcome";
    style=filled; fillcolor="#FFF8E1";
    rank=same;
    out_auto_1hit [label="AUTO-LINK\n1 match found", shape=diamond, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="Exact date+amount, no TUI needed"];
    out_currency_convert [label="CURRENCY CONVERT\nuser enters rate", shape=diamond, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Receipt GBP != CSV EUR, user provides conversion ratio"];
  }

  subgraph cluster_journal_out {
    label="Journal Output";
    style=filled; fillcolor="#E8EAF6";
    rank=same;
    jrnl_groceries_ekoplaza [label="Expenses:Groceries:\nEkoplaza 42.17 EUR", shape=box, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="Debit groceries, credit Triodos checking"];
    jrnl_triodos_debit_gbp [label="Assets:Triodos:\nChecking -117.50 EUR", shape=box, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Bank debit for GBP withdrawal"];
    jrnl_wallet_gbp [label="Assets:Wallet:\nGBP 100", shape=box, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Foreign currency asset from ATM withdrawal"];
  }

  subgraph cluster_visualization {
    label="Visualisation";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    viz_sankey [label="Sankey Diagram", shape=octagon, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="Interactive Plotly Sankey of all flows"];
    viz_treemap [label="Treemap Plot", shape=octagon, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="Interactive Plotly Treemap of spending"];
  }

