    label="Journal Output";
    style=filled; fillcolor="#E8EAF6";
    rank=same;
    jrnl_groceries_ekoplaza [label="Expenses:Groceries:\nEkoplaza 42.17 EUR", shape=box, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Debit groceries, credit Triodos checking"];
