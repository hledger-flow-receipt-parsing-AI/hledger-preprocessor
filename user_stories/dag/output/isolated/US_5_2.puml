@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config {
    label="Configuration";
    style=filled; fillcolor="#E3F2FD";
    rank=same;
    cfg_1b1w [label="1 bank + 1 wallet", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos checking (EUR CSV) + EUR cash wallet (no CSV)"];
  }

  subgraph cluster_categories {
    label="Categories";
    style=filled; fillcolor="#E8F5E9";
    rank=same;
    cat_basic [label="basic categories", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="groceries:{ekoplaza,supermarket}, repairs:{bike}, withdrawl:{euro:{pound}}"];
  }

  subgraph cluster_matching_cfg {
    label="Matching Parameters";
    style=filled; fillcolor="#FFF3E0";
    rank=same;
    match_default [label="default (±2d, exact)", shape=component, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="days:2, amount_range:0, days_month_swap:true"];
  }

  subgraph cluster_start_journal {
    label="Starting Journal";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    start_2024_1000eur [label="2024: 1000 EUR", shape=note, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Opening balance: Assets:Triodos:Checking 1000 EUR"];
  }

  _skip_csv_txn [label="Bank CSV Transactions", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_receipt_img [label="Receipt Images", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_receipt_lbl [label="Receipt Labels (JSON)", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_matching_out [label="Matching Outcome", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  subgraph cluster_journal_out {
    label="Journal Output";
    style=filled; fillcolor="#E8EAF6";
    rank=same;
    jrnl_groceries_ekoplaza [label="Expenses:Groceries:\nEkoplaza 42.17 EUR", shape=box, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Debit groceries, credit Triodos checking"];
  }

  subgraph cluster_visualization {
    label="Visualisation";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    viz_treemap [label="Treemap Plot", shape=octagon, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="Interactive Plotly Treemap of spending"];
  }

  cfg_1b1w -> cat_basic [style=invis];
  cat_basic -> match_default [style=invis];
  match_default -> start_2024_1000eur [style=invis];
  start_2024_1000eur -> _skip_csv_txn [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_csv_txn -> _skip_receipt_img [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_receipt_img -> _skip_receipt_lbl [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_receipt_lbl -> _skip_matching_out [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_matching_out -> jrnl_groceries_ekoplaza [style=dotted, color="#CCCCCC", arrowhead=none];
  jrnl_groceries_ekoplaza -> viz_treemap [style=invis];

  cat_basic -> match_default [color="#9C27B0", penwidth=2.5, style=bold];
  cfg_1b1w -> cat_basic [color="#9C27B0", penwidth=2.5, style=bold];
  jrnl_groceries_ekoplaza -> viz_treemap [color="#9C27B0", penwidth=2.5, style=bold];
  match_default -> start_2024_1000eur [color="#9C27B0", penwidth=2.5, style=bold];
  start_2024_1000eur -> jrnl_groceries_ekoplaza [color="#9C27B0", penwidth=2.5, style=bold];
}
@enddot