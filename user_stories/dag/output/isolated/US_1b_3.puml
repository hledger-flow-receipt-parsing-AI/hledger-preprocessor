@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config_group {
    label="Configuration";
    labeljust=l;
    style="dashed"; color="#888888";
    penwidth=1.5;
    _skip_config_accounts [label="Account Configuration", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

    _skip_config_dir_paths [label="Directory Paths", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

    _skip_config_file_names [label="Filename Convention", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

    subgraph cluster_config_categorisation {
      label="Categorisation Config";
      style=filled; fillcolor="#64B5F6";
      rank=same;
      catcfg_default [label="Default categorisation", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard categorisation settings from config.yaml"];
    }

    _skip_config_matching_algo [label="Matching Algo Config", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  }

  subgraph cluster_categories {
    label="Categories";
    style=filled; fillcolor="#E8F5E9";
    rank=same;
    cat_with_income [label="categories + income", shape=box3d, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="basic + income:{salary,freelance}"];
  }

  _skip_matching_cfg [label="Matching Parameters", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_start_journal [label="Starting Journal", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_csv_txn [label="Bank CSV Transactions", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_receipt_img [label="Receipt Images", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_receipt_lbl_before [label="No label exists yet", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_receipt_lbl_tui [label="Label receipt in TUI", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_receipt_lbl_after [label="Receipt label output JSON", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_matching_out [label="Matching Outcome", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_journal_out [label="Journal Output", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_visualization [label="Visualisation", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_config_accounts -> _skip_config_dir_paths [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_config_dir_paths -> _skip_config_file_names [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_config_file_names -> catcfg_default [style=dotted, color="#CCCCCC", arrowhead=none];
  catcfg_default -> _skip_config_matching_algo [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_config_matching_algo -> cat_with_income [style=dotted, color="#CCCCCC", arrowhead=none];
  cat_with_income -> _skip_matching_cfg [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_matching_cfg -> _skip_start_journal [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_start_journal -> _skip_csv_txn [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_csv_txn -> _skip_receipt_img [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_receipt_img -> _skip_receipt_lbl_before [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_receipt_lbl_before -> _skip_receipt_lbl_tui [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_receipt_lbl_tui -> _skip_receipt_lbl_after [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_receipt_lbl_after -> _skip_matching_out [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_matching_out -> _skip_journal_out [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_journal_out -> _skip_visualization [style=dotted, color="#CCCCCC", arrowhead=none];

  catcfg_default -> cat_with_income [color="#CDDC39", penwidth=2.5, style=solid];
}
@enddot
