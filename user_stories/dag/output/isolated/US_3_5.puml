@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config {
    label="Configuration";
    style=filled; fillcolor="#E3F2FD";
    rank=same;
    cfg_1b1w [label="1 bank + 1 wallet", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos checking (EUR CSV) + EUR cash wallet (no CSV)"];
  }

  subgraph cluster_categories {
    label="Categories";
    style=filled; fillcolor="#E8F5E9";
    rank=same;
    cat_basic [label="basic categories", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="groceries:{ekoplaza,supermarket}, repairs:{bike}, withdrawl:{euro:{pound}}"];
  }

  subgraph cluster_matching_cfg {
    label="Matching Parameters";
    style=filled; fillcolor="#FFF3E0";
    rank=same;
    match_default [label="default (±2d, exact)", shape=component, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="days:2, amount_range:0, days_month_swap:true"];
  }

  subgraph cluster_start_journal {
    label="Starting Journal";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    start_2024_1000eur [label="2024: 1000 EUR", shape=note, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Opening balance: Assets:Triodos:Checking 1000 EUR"];
  }

  subgraph cluster_csv_txn {
    label="Bank CSV Transactions";
    style=filled; fillcolor="#E0F7FA";
    rank=same;
    csv_swapped_date [label="Triodos -25.00 EUR\n2025-05-01 BookShop", shape=cylinder, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Receipt entered as 01-05 but meant 05-01"];
  }

  subgraph cluster_receipt_img {
    label="Receipt Images";
    style=filled; fillcolor="#FBE9E7";
    rank=same;
    img_swapped_date [label="bookshop.jpg", shape=folder, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Receipt with ambiguous DD-MM date"];
  }

  subgraph cluster_receipt_lbl {
    label="Receipt Labels (JSON)";
    style=filled; fillcolor="#FCE4EC";
    rank=same;
    lbl_swapped_date [label="bookshop\nEUR 25.00 card", shape=tab, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Triodos account, date entered as 01-05-2025"];
  }

  subgraph cluster_matching_out {
    label="Matching Outcome";
    style=filled; fillcolor="#FFF8E1";
    rank=same;
    out_swap_dd_mm [label="SWAP DD/MM\n01-05 -> 05-01", shape=diamond, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Auto-retry with day/month swapped"];
  }

  subgraph cluster_journal_out {
    label="Journal Output";
    style=filled; fillcolor="#E8EAF6";
    rank=same;
    jrnl_swapped_shop [label="Expenses:Shopping\n25.00 EUR", shape=box, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Date-swapped receipt matched after DD/MM fix"];
  }

  _skip_visualization [label="Visualisation", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  cfg_1b1w -> cat_basic [style=invis];
  cat_basic -> match_default [style=invis];
  match_default -> start_2024_1000eur [style=invis];
  start_2024_1000eur -> csv_swapped_date [style=invis];
  csv_swapped_date -> img_swapped_date [style=invis];
  img_swapped_date -> lbl_swapped_date [style=invis];
  lbl_swapped_date -> out_swap_dd_mm [style=invis];
  out_swap_dd_mm -> jrnl_swapped_shop [style=invis];
  jrnl_swapped_shop -> _skip_visualization [style=dotted, color="#CCCCCC", arrowhead=none];

  cat_basic -> match_default [color="#E65100", penwidth=2.5, style=dashed];
  cfg_1b1w -> cat_basic [color="#E65100", penwidth=2.5, style=dashed];
  csv_swapped_date -> img_swapped_date [color="#E65100", penwidth=2.5, style=dashed];
  img_swapped_date -> lbl_swapped_date [color="#E65100", penwidth=2.5, style=dashed];
  lbl_swapped_date -> out_swap_dd_mm [color="#E65100", penwidth=2.5, style=dashed];
  match_default -> start_2024_1000eur [color="#E65100", penwidth=2.5, style=dashed];
  out_swap_dd_mm -> jrnl_swapped_shop [color="#E65100", penwidth=2.5, style=dashed];
  start_2024_1000eur -> csv_swapped_date [color="#E65100", penwidth=2.5, style=dashed];
}
@enddot
