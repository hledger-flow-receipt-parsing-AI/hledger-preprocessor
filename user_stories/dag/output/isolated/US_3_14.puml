@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config {
    label="Configuration";
    style=filled; fillcolor="#E3F2FD";
    rank=same;
    cfg_1b1w [label="1 bank + 1 wallet", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos checking (EUR CSV) + EUR cash wallet (no CSV)"];
  }

  subgraph cluster_categories {
    label="Categories";
    style=filled; fillcolor="#E8F5E9";
    rank=same;
    cat_basic [label="basic categories", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="groceries:{ekoplaza,supermarket}, repairs:{bike}, withdrawl:{euro:{pound}}"];
  }

  subgraph cluster_matching_cfg {
    label="Matching Parameters";
    style=filled; fillcolor="#FFF3E0";
    rank=same;
    match_default [label="default (±2d, exact)", shape=component, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="days:2, amount_range:0, days_month_swap:true"];
  }

  subgraph cluster_start_journal {
    label="Starting Journal";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    start_2024_1000eur [label="2024: 1000 EUR", shape=note, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Opening balance: Assets:Triodos:Checking 1000 EUR"];
  }

  subgraph cluster_csv_txn {
    label="Bank CSV Transactions";
    style=filled; fillcolor="#E0F7FA";
    rank=same;
    csv_ekoplaza_4217_jan15 [label="Triodos -42.17 EUR\n2025-01-15 Ekoplaza", shape=cylinder, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Debit card purchase at Ekoplaza, exact date match"];
  }

  subgraph cluster_receipt_img {
    label="Receipt Images";
    style=filled; fillcolor="#FBE9E7";
    rank=same;
    img_ekoplaza_card [label="ekoplaza_card.jpg", shape=folder, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Ekoplaza receipt, paid by card"];
  }

  subgraph cluster_receipt_lbl {
    label="Receipt Labels (JSON)";
    style=filled; fillcolor="#FCE4EC";
    rank=same;
    lbl_ekoplaza_card_eur [label="ekoplaza_card\nEUR 42.17 card", shape=tab, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos account, 2025-01-15, groceries:ekoplaza"];
  }

  subgraph cluster_matching_out {
    label="Matching Outcome";
    style=filled; fillcolor="#FFF8E1";
    rank=same;
    out_duplicate_blocked [label="BLOCKED\nalready linked", shape=diamond, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="CSV transaction already claimed by another receipt"];
  }

  _skip_journal_out [label="Journal Output", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_visualization [label="Visualisation", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  cfg_1b1w -> cat_basic [style=invis];
  cat_basic -> match_default [style=invis];
  match_default -> start_2024_1000eur [style=invis];
  start_2024_1000eur -> csv_ekoplaza_4217_jan15 [style=invis];
  csv_ekoplaza_4217_jan15 -> img_ekoplaza_card [style=invis];
  img_ekoplaza_card -> lbl_ekoplaza_card_eur [style=invis];
  lbl_ekoplaza_card_eur -> out_duplicate_blocked [style=invis];
  out_duplicate_blocked -> _skip_journal_out [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_journal_out -> _skip_visualization [style=dotted, color="#CCCCCC", arrowhead=none];

  cat_basic -> match_default [color="#B71C1C", penwidth=2.5, style=dotted];
  cfg_1b1w -> cat_basic [color="#B71C1C", penwidth=2.5, style=dotted];
  csv_ekoplaza_4217_jan15 -> img_ekoplaza_card [color="#B71C1C", penwidth=2.5, style=dotted];
  img_ekoplaza_card -> lbl_ekoplaza_card_eur [color="#B71C1C", penwidth=2.5, style=dotted];
  lbl_ekoplaza_card_eur -> out_duplicate_blocked [color="#B71C1C", penwidth=2.5, style=dotted];
  match_default -> start_2024_1000eur [color="#B71C1C", penwidth=2.5, style=dotted];
  start_2024_1000eur -> csv_ekoplaza_4217_jan15 [color="#B71C1C", penwidth=2.5, style=dotted];
}
@enddot
