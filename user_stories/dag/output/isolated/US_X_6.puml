@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  _skip_config [label="Configuration", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_categories [label="Categories", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_matching_cfg [label="Matching Parameters", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_start_journal [label="Starting Journal", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_csv_txn [label="Bank CSV Transactions", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  subgraph cluster_receipt_img {
    label="Receipt Images";
    style=filled; fillcolor="#FBE9E7";
    rank=same;
    img_ekoplaza_card [label="ekoplaza_card.jpg", shape=folder, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Ekoplaza receipt, paid by card"];
  }

  subgraph cluster_receipt_lbl {
    label="Receipt Labels (JSON)";
    style=filled; fillcolor="#FCE4EC";
    rank=same;
    lbl_ekoplaza_card_eur [label="ekoplaza_card\nEUR 42.17 card", shape=tab, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos account, 2025-01-15, groceries:ekoplaza"];
  }

  _skip_matching_out [label="Matching Outcome", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_journal_out [label="Journal Output", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_visualization [label="Visualisation", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_config -> _skip_categories [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_categories -> _skip_matching_cfg [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_matching_cfg -> _skip_start_journal [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_start_journal -> _skip_csv_txn [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_csv_txn -> img_ekoplaza_card [style=dotted, color="#CCCCCC", arrowhead=none];
  img_ekoplaza_card -> lbl_ekoplaza_card_eur [style=invis];
  lbl_ekoplaza_card_eur -> _skip_matching_out [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_matching_out -> _skip_journal_out [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_journal_out -> _skip_visualization [style=dotted, color="#CCCCCC", arrowhead=none];

  img_ekoplaza_card -> lbl_ekoplaza_card_eur [color="#455A64", penwidth=2.5, style=solid];
}
@enddot
