@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config_group {
    label="Configuration";
    labeljust=l;
    style="dashed"; color="#888888";
    penwidth=1.5;
    _skip_config_accounts [label="Account Configuration", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

    _skip_config_dir_paths [label="Directory Paths", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

    _skip_config_file_names [label="Filename Convention", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

    _skip_config_categorisation [label="Categorisation Config", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

    _skip_config_matching_algo [label="Matching Algo Config", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  }

  _skip_categories [label="Categories", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_matching_cfg [label="Matching Parameters", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_start_journal [label="Starting Journal", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_csv_txn [label="Bank CSV Transactions", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  subgraph cluster_receipt_img {
    label="Receipt Images";
    style=filled; fillcolor="#FBE9E7";
    rank=same;
    img_ekoplaza_card [label="ekoplaza_card.jpg", shape=folder, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Ekoplaza receipt, paid by card"];
  }

  subgraph cluster_receipt_lbl_before {
    label="No label exists yet";
    style=filled; fillcolor="#FFF0F3";
    rank=same;
    nolbl_ekoplaza_card_eur [label="ekoplaza_card\n(no label)", shape=tab, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="No receipt label JSON exists yet for ekoplaza card receipt"];
  }

  subgraph cluster_receipt_lbl_tui {
    label="Label receipt in TUI";
    style=filled; fillcolor="#FCE4EC";
    rank=same;
    tui_ekoplaza_card_eur [label="TUI label\nekoplaza_card", shape=tab, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Label ekoplaza card receipt via TUI based on image"];
  }

  subgraph cluster_receipt_lbl_after {
    label="Receipt label output JSON";
    style=filled; fillcolor="#F8BBD0";
    rank=same;
    lbl_ekoplaza_card_eur [label="ekoplaza_card\nEUR 42.17 card", shape=tab, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos account, 2025-01-15, groceries:ekoplaza"];
  }

  _skip_matching_out [label="Matching Outcome", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_journal_out [label="Journal Output", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_visualization [label="Visualisation", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_config_accounts -> _skip_config_dir_paths [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_config_dir_paths -> _skip_config_file_names [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_config_file_names -> _skip_config_categorisation [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_config_categorisation -> _skip_config_matching_algo [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_config_matching_algo -> _skip_categories [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_categories -> _skip_matching_cfg [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_matching_cfg -> _skip_start_journal [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_start_journal -> _skip_csv_txn [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_csv_txn -> img_ekoplaza_card [style=dotted, color="#CCCCCC", arrowhead=none];
  img_ekoplaza_card -> nolbl_ekoplaza_card_eur [style=invis];
  nolbl_ekoplaza_card_eur -> tui_ekoplaza_card_eur [style=invis];
  tui_ekoplaza_card_eur -> lbl_ekoplaza_card_eur [style=invis];
  lbl_ekoplaza_card_eur -> _skip_matching_out [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_matching_out -> _skip_journal_out [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_journal_out -> _skip_visualization [style=dotted, color="#CCCCCC", arrowhead=none];

  img_ekoplaza_card -> nolbl_ekoplaza_card_eur [color="#455A64", penwidth=2.5, style=solid];
  nolbl_ekoplaza_card_eur -> tui_ekoplaza_card_eur [color="#455A64", penwidth=2.5, style=solid];
  tui_ekoplaza_card_eur -> lbl_ekoplaza_card_eur [color="#455A64", penwidth=2.5, style=solid];
}
@enddot
