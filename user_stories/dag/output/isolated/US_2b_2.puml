@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config {
    label="Configuration";
    style=filled; fillcolor="#E3F2FD";
    rank=same;
    cfg_1b1w [label="1 bank + 1 wallet", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos checking (EUR CSV) + EUR cash wallet (no CSV)"];
  }

  subgraph cluster_categories {
    label="Categories";
    style=filled; fillcolor="#E8F5E9";
    rank=same;
    cat_basic [label="basic categories", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="groceries:{ekoplaza,supermarket}, repairs:{bike}, withdrawl:{euro:{pound}}"];
  }

  subgraph cluster_matching_cfg {
    label="Matching Parameters";
    style=filled; fillcolor="#FFF3E0";
    rank=same;
    match_default [label="default (±2d, exact)", shape=component, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="days:2, amount_range:0, days_month_swap:true"];
  }

  subgraph cluster_start_journal {
    label="Starting Journal";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    start_2024_1000eur [label="2024: 1000 EUR", shape=note, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Opening balance: Assets:Triodos:Checking 1000 EUR"];
  }

  _skip_csv_txn [label="Bank CSV Transactions", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  subgraph cluster_receipt_img {
    label="Receipt Images";
    style=filled; fillcolor="#FBE9E7";
    rank=same;
    img_coffee_cash [label="coffee_cash.jpg", shape=folder, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="Coffee receipt, paid cash"];
  }

  subgraph cluster_receipt_lbl {
    label="Receipt Labels (JSON)";
    style=filled; fillcolor="#FCE4EC";
    rank=same;
    lbl_coffee_cash [label="coffee_cash\nEUR 3.50 cash", shape=tab, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="EUR wallet, dining:coffee"];
  }

  subgraph cluster_matching_out {
    label="Matching Outcome";
    style=filled; fillcolor="#FFF8E1";
    rank=same;
    out_skip_cash [label="SKIP\nno CSV for wallet", shape=diamond, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="Cash receipt, no bank CSV to match against"];
  }

  subgraph cluster_journal_out {
    label="Journal Output";
    style=filled; fillcolor="#E8EAF6";
    rank=same;
    jrnl_coffee_cash [label="Expenses:Dining:\nCoffee 3.50 EUR", shape=box, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="Debit dining, credit EUR wallet"];
  }

  _skip_visualization [label="Visualisation", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  cfg_1b1w -> cat_basic [style=invis];
  cat_basic -> match_default [style=invis];
  match_default -> start_2024_1000eur [style=invis];
  start_2024_1000eur -> _skip_csv_txn [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_csv_txn -> img_coffee_cash [style=dotted, color="#CCCCCC", arrowhead=none];
  img_coffee_cash -> lbl_coffee_cash [style=invis];
  lbl_coffee_cash -> out_skip_cash [style=invis];
  out_skip_cash -> jrnl_coffee_cash [style=invis];
  jrnl_coffee_cash -> _skip_visualization [style=dotted, color="#CCCCCC", arrowhead=none];

  cat_basic -> match_default [color="#F44336", penwidth=2.5, style=solid];
  cfg_1b1w -> cat_basic [color="#F44336", penwidth=2.5, style=solid];
  img_coffee_cash -> lbl_coffee_cash [color="#F44336", penwidth=2.5, style=solid];
  lbl_coffee_cash -> out_skip_cash [color="#F44336", penwidth=2.5, style=solid];
  match_default -> start_2024_1000eur [color="#F44336", penwidth=2.5, style=solid];
  out_skip_cash -> jrnl_coffee_cash [color="#F44336", penwidth=2.5, style=solid];
  start_2024_1000eur -> img_coffee_cash [color="#F44336", penwidth=2.5, style=solid];
}
@enddot
