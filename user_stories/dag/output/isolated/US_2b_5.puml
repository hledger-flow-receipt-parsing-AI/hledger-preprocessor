@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config_group {
    label="Configuration";
    labeljust=l;
    style="dashed"; color="#888888";
    penwidth=1.5;
    subgraph cluster_config_accounts {
      label="Account Configuration";
      style=filled; fillcolor="#E3F2FD";
      rank=same;
      acct_eur_wallet [label="EUR physical\nwallet", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="EUR cash wallet — no CSV import"];
      acct_triodos_csv [label="Triodos checking\n(EUR CSV)", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos checking account — imports from CSV"];
    }

    subgraph cluster_config_dir_paths {
      label="Directory Paths";
      style=filled; fillcolor="#BBDEFB";
      rank=same;
      dirp_default [label="Default dir paths", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard directory layout: import/{holder}/{bank}/{type}/{year}/"];
    }

    subgraph cluster_config_file_names {
      label="Filename Convention";
      style=filled; fillcolor="#90CAF9";
      rank=same;
      fnames_default [label="Default filenames", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard filename conventions for CSV, rules, and journal files"];
    }

    subgraph cluster_config_categorisation {
      label="Categorisation Config";
      style=filled; fillcolor="#64B5F6";
      rank=same;
      catcfg_default [label="Default categorisation", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard categorisation settings from config.yaml"];
    }

    subgraph cluster_config_matching_algo {
      label="Matching Algo Config";
      style=filled; fillcolor="#42A5F5";
      rank=same;
      malgo_default [label="Default matching algo", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard matching algorithm settings from config.yaml"];
    }

  }

  subgraph cluster_categories {
    label="Categories";
    style=filled; fillcolor="#E8F5E9";
    rank=same;
    cat_basic [label="basic categories", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="groceries:{ekoplaza,supermarket}, repairs:{bike}, withdrawl:{euro:{pound}}"];
  }

  _skip_matching_cfg [label="Matching Parameters", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  subgraph cluster_start_journal {
    label="Starting Journal";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    start_2024_1000eur [label="2024: 1000 EUR", shape=note, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Opening balance: Assets:Triodos:Checking 1000 EUR"];
  }

  _skip_csv_txn [label="Bank CSV Transactions", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  subgraph cluster_receipt_img {
    label="Receipt Images";
    style=filled; fillcolor="#FBE9E7";
    rank=same;
    img_return_item [label="return_item.jpg", shape=folder, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Receipt with bought + returned items"];
  }

  subgraph cluster_receipt_lbl_before {
    label="No label exists yet";
    style=filled; fillcolor="#FFF0F3";
    rank=same;
    nolbl_return_item [label="return_item\n(no label)", shape=tab, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="No receipt label JSON exists yet for return"];
  }

  subgraph cluster_receipt_lbl_tui {
    label="Label receipt in TUI";
    style=filled; fillcolor="#FCE4EC";
    rank=same;
    tui_return_item [label="TUI label\nreturn_item", shape=tab, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Label return receipt via TUI"];
  }

  subgraph cluster_receipt_lbl_after {
    label="Receipt label output JSON";
    style=filled; fillcolor="#F8BBD0";
    rank=same;
    lbl_return_item [label="return_item\nbought 3, returned 1", shape=tab, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Net EUR 28.50 (bought 42.50 - returned 14.00)"];
  }

  subgraph cluster_matching_out {
    label="Matching Outcome";
    style=filled; fillcolor="#FFF8E1";
    rank=same;
    out_auto_1hit [label="AUTO-LINK\n1 match found", shape=diamond, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="Exact date+amount, no TUI needed"];
  }

  subgraph cluster_journal_out {
    label="Journal Output";
    style=filled; fillcolor="#E8EAF6";
    rank=same;
    jrnl_return_net [label="Expenses:Shopping\n28.50 EUR (net)", shape=box, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Net after return: 42.50 bought - 14.00 returned"];
  }

  _skip_visualization [label="Visualisation", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  acct_eur_wallet -> dirp_default [style=invis];
  dirp_default -> fnames_default [style=invis];
  fnames_default -> catcfg_default [style=invis];
  catcfg_default -> malgo_default [style=invis];
  malgo_default -> cat_basic [style=invis];
  cat_basic -> _skip_matching_cfg [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_matching_cfg -> start_2024_1000eur [style=dotted, color="#CCCCCC", arrowhead=none];
  start_2024_1000eur -> _skip_csv_txn [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_csv_txn -> img_return_item [style=dotted, color="#CCCCCC", arrowhead=none];
  img_return_item -> nolbl_return_item [style=invis];
  nolbl_return_item -> tui_return_item [style=invis];
  tui_return_item -> lbl_return_item [style=invis];
  lbl_return_item -> out_auto_1hit [style=invis];
  out_auto_1hit -> jrnl_return_net [style=invis];
  jrnl_return_net -> _skip_visualization [style=dotted, color="#CCCCCC", arrowhead=none];

  acct_eur_wallet -> dirp_default [color="#607D8B", penwidth=2.5, style=solid];
  acct_triodos_csv -> acct_eur_wallet [color="#607D8B", penwidth=2.5, style=solid];
  cat_basic -> start_2024_1000eur [color="#607D8B", penwidth=2.5, style=solid];
  catcfg_default -> malgo_default [color="#607D8B", penwidth=2.5, style=solid];
  dirp_default -> fnames_default [color="#607D8B", penwidth=2.5, style=solid];
  fnames_default -> catcfg_default [color="#607D8B", penwidth=2.5, style=solid];
  img_return_item -> nolbl_return_item [color="#607D8B", penwidth=2.5, style=solid];
  lbl_return_item -> out_auto_1hit [color="#607D8B", penwidth=2.5, style=solid];
  malgo_default -> cat_basic [color="#607D8B", penwidth=2.5, style=solid];
  nolbl_return_item -> tui_return_item [color="#607D8B", penwidth=2.5, style=solid];
  out_auto_1hit -> jrnl_return_net [color="#607D8B", penwidth=2.5, style=solid];
  start_2024_1000eur -> img_return_item [color="#607D8B", penwidth=2.5, style=solid];
  tui_return_item -> lbl_return_item [color="#607D8B", penwidth=2.5, style=solid];
}
@enddot