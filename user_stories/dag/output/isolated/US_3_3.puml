@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config {
    label="Configuration";
    style=filled; fillcolor="#E3F2FD";
    rank=same;
    cfg_1b1w [label="1 bank + 1 wallet", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos checking (EUR CSV) + EUR cash wallet (no CSV)"];
  }

  subgraph cluster_categories {
    label="Categories";
    style=filled; fillcolor="#E8F5E9";
    rank=same;
    cat_basic [label="basic categories", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="groceries:{ekoplaza,supermarket}, repairs:{bike}, withdrawl:{euro:{pound}}"];
  }

  subgraph cluster_matching_cfg {
    label="Matching Parameters";
    style=filled; fillcolor="#FFF3E0";
    rank=same;
    match_narrow [label="narrow (±1d, exact)", shape=component, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="days:1, amount_range:0 — initially too tight"];
  }

  subgraph cluster_start_journal {
    label="Starting Journal";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    start_2024_1000eur [label="2024: 1000 EUR", shape=note, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Opening balance: Assets:Triodos:Checking 1000 EUR"];
  }

  subgraph cluster_csv_txn {
    label="Bank CSV Transactions";
    style=filled; fillcolor="#E0F7FA";
    rank=same;
    csv_delayed_jan18 [label="Triodos -49.99 EUR\n2025-01-18 ShopX", shape=cylinder, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Posted 3 days late (receipt dated Jan 15)"];
  }

  subgraph cluster_receipt_img {
    label="Receipt Images";
    style=filled; fillcolor="#FBE9E7";
    rank=same;
    img_delayed_shop [label="delayed_shop.jpg", shape=folder, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Receipt dated Jan 15, bank posted Jan 18"];
  }

  subgraph cluster_receipt_lbl {
    label="Receipt Labels (JSON)";
    style=filled; fillcolor="#FCE4EC";
    rank=same;
    lbl_delayed_shop [label="delayed_shop\nEUR 49.99 card", shape=tab, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Triodos account, receipt dated Jan 15"];
  }

  subgraph cluster_matching_out {
    label="Matching Outcome";
    style=filled; fillcolor="#FFF8E1";
    rank=same;
    out_widen_date [label="WIDEN DATE\n±2d -> ±5d", shape=diamond, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="No match at ±2d, user widens to ±5d, finds match"];
  }

  subgraph cluster_journal_out {
    label="Journal Output";
    style=filled; fillcolor="#E8EAF6";
    rank=same;
    jrnl_delayed_shop [label="Expenses:Shopping\n49.99 EUR", shape=box, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Delayed posting matched after widening date"];
  }

  _skip_visualization [label="Visualisation", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  cfg_1b1w -> cat_basic [style=invis];
  cat_basic -> match_narrow [style=invis];
  match_narrow -> start_2024_1000eur [style=invis];
  start_2024_1000eur -> csv_delayed_jan18 [style=invis];
  csv_delayed_jan18 -> img_delayed_shop [style=invis];
  img_delayed_shop -> lbl_delayed_shop [style=invis];
  lbl_delayed_shop -> out_widen_date [style=invis];
  out_widen_date -> jrnl_delayed_shop [style=invis];
  jrnl_delayed_shop -> _skip_visualization [style=dotted, color="#CCCCCC", arrowhead=none];

  cat_basic -> match_narrow [color="#F57C00", penwidth=2.5, style=dashed];
  cfg_1b1w -> cat_basic [color="#F57C00", penwidth=2.5, style=dashed];
  csv_delayed_jan18 -> img_delayed_shop [color="#F57C00", penwidth=2.5, style=dashed];
  img_delayed_shop -> lbl_delayed_shop [color="#F57C00", penwidth=2.5, style=dashed];
  lbl_delayed_shop -> out_widen_date [color="#F57C00", penwidth=2.5, style=dashed];
  match_narrow -> start_2024_1000eur [color="#F57C00", penwidth=2.5, style=dashed];
  out_widen_date -> jrnl_delayed_shop [color="#F57C00", penwidth=2.5, style=dashed];
  start_2024_1000eur -> csv_delayed_jan18 [color="#F57C00", penwidth=2.5, style=dashed];
}
@enddot
