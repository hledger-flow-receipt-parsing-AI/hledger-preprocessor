@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config_accounts {
    label="Account Configuration";
    style=filled; fillcolor="#E3F2FD";
    rank=same;
    acct_btc_wallet [label="BTC digital\nwallet", shape=box3d, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="BTC digital wallet / exchange"];
    acct_eur_wallet [label="EUR physical\nwallet", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="EUR cash wallet — no CSV import"];
    acct_gbp_wallet [label="GBP physical\nwallet", shape=box3d, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="GBP cash wallet — foreign currency"];
    acct_gold_wallet [label="GOLD physical\nwallet", shape=box3d, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="GOLD physical asset wallet"];
    acct_silver_wallet [label="SILVER physical\nwallet", shape=box3d, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="SILVER physical asset wallet"];
    acct_triodos_csv [label="Triodos checking\n(EUR CSV)", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos checking account — imports from CSV"];
  }

  subgraph cluster_config_dir_paths {
    label="Directory Paths";
    style=filled; fillcolor="#BBDEFB";
    rank=same;
    dirp_default [label="Default dir paths", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard directory layout: import/{holder}/{bank}/{type}/{year}/"];
  }

  subgraph cluster_config_file_names {
    label="Filename Convention";
    style=filled; fillcolor="#90CAF9";
    rank=same;
    fnames_default [label="Default filenames", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard filename conventions for CSV, rules, and journal files"];
  }

  subgraph cluster_config_categorisation {
    label="Categorisation Config";
    style=filled; fillcolor="#64B5F6";
    rank=same;
    catcfg_default [label="Default categorisation", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard categorisation settings from config.yaml"];
  }

  subgraph cluster_config_matching_algo {
    label="Matching Algo Config";
    style=filled; fillcolor="#42A5F5";
    rank=same;
    malgo_default [label="Default matching algo", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard matching algorithm settings from config.yaml"];
  }

  subgraph cluster_categories {
    label="Categories";
    style=filled; fillcolor="#E8F5E9";
    rank=same;
    cat_basic [label="basic categories", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="groceries:{ekoplaza,supermarket}, repairs:{bike}, withdrawl:{euro:{pound}}"];
  }

  subgraph cluster_matching_cfg {
    label="Matching Parameters";
    style=filled; fillcolor="#FFF3E0";
    rank=same;
    match_default [label="default (±2d, exact)", shape=component, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="days:2, amount_range:0, days_month_swap:true"];
  }

  subgraph cluster_start_journal {
    label="Starting Journal";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    start_2024_1000eur [label="2024: 1000 EUR", shape=note, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Opening balance: Assets:Triodos:Checking 1000 EUR"];
  }

  subgraph cluster_csv_txn {
    label="Bank CSV Transactions";
    style=filled; fillcolor="#E0F7FA";
    rank=same;
    csv_atm_gbp_11750 [label="Triodos -117.50 EUR\n2025-01-15 ATM London", shape=cylinder, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="Foreign ATM withdrawal: 100 GBP * 1.175"];
  }

  subgraph cluster_receipt_img {
    label="Receipt Images";
    style=filled; fillcolor="#FBE9E7";
    rank=same;
    img_atm_gbp [label="atm_london.jpg", shape=folder, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="ATM withdrawal slip, 100 GBP"];
  }

  subgraph cluster_receipt_lbl {
    label="Receipt Labels (JSON)";
    style=filled; fillcolor="#FCE4EC";
    rank=same;
    lbl_atm_100gbp [label="atm_100gbp\nGBP 100 withdrawal", shape=tab, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="Triodos account, GBP withdrawal receipt"];
  }

  subgraph cluster_matching_out {
    label="Matching Outcome";
    style=filled; fillcolor="#FFF8E1";
    rank=same;
    out_currency_convert [label="CURRENCY CONVERT\nuser enters rate", shape=diamond, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="Receipt GBP != CSV EUR, user provides conversion ratio"];
  }

  subgraph cluster_journal_out {
    label="Journal Output";
    style=filled; fillcolor="#E8EAF6";
    rank=same;
    jrnl_triodos_debit_gbp [label="Assets:Triodos:\nChecking -117.50 EUR", shape=box, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="Bank debit for GBP withdrawal"];
    jrnl_wallet_gbp [label="Assets:Wallet:\nGBP 100", shape=box, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="Foreign currency asset from ATM withdrawal"];
  }

  _skip_visualization [label="Visualisation", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  acct_btc_wallet -> dirp_default [style=invis];
  dirp_default -> fnames_default [style=invis];
  fnames_default -> catcfg_default [style=invis];
  catcfg_default -> malgo_default [style=invis];
  malgo_default -> cat_basic [style=invis];
  cat_basic -> match_default [style=invis];
  match_default -> start_2024_1000eur [style=invis];
  start_2024_1000eur -> csv_atm_gbp_11750 [style=invis];
  csv_atm_gbp_11750 -> img_atm_gbp [style=invis];
  img_atm_gbp -> lbl_atm_100gbp [style=invis];
  lbl_atm_100gbp -> out_currency_convert [style=invis];
  out_currency_convert -> jrnl_triodos_debit_gbp [style=invis];
  jrnl_triodos_debit_gbp -> _skip_visualization [style=dotted, color="#CCCCCC", arrowhead=none];

  acct_btc_wallet -> acct_gold_wallet [color="#FF6F00", penwidth=2.5, style=bold];
  acct_eur_wallet -> acct_gbp_wallet [color="#FF6F00", penwidth=2.5, style=bold];
  acct_gbp_wallet -> acct_btc_wallet [color="#FF6F00", penwidth=2.5, style=bold];
  acct_gold_wallet -> acct_silver_wallet [color="#FF6F00", penwidth=2.5, style=bold];
  acct_silver_wallet -> dirp_default [color="#FF6F00", penwidth=2.5, style=bold];
  acct_triodos_csv -> acct_eur_wallet [color="#FF6F00", penwidth=2.5, style=bold];
  cat_basic -> match_default [color="#FF6F00", penwidth=2.5, style=bold];
  catcfg_default -> malgo_default [color="#FF6F00", penwidth=2.5, style=bold];
  csv_atm_gbp_11750 -> img_atm_gbp [color="#FF6F00", penwidth=2.5, style=bold];
  dirp_default -> fnames_default [color="#FF6F00", penwidth=2.5, style=bold];
  fnames_default -> catcfg_default [color="#FF6F00", penwidth=2.5, style=bold];
  img_atm_gbp -> lbl_atm_100gbp [color="#FF6F00", penwidth=2.5, style=bold];
  lbl_atm_100gbp -> out_currency_convert [color="#FF6F00", penwidth=2.5, style=bold];
  malgo_default -> cat_basic [color="#FF6F00", penwidth=2.5, style=bold];
  match_default -> start_2024_1000eur [color="#FF6F00", penwidth=2.5, style=bold];
  out_currency_convert -> jrnl_triodos_debit_gbp [color="#FF6F00", penwidth=2.5, style=bold];
  out_currency_convert -> jrnl_wallet_gbp [color="#FF6F00", penwidth=2.5, style=bold];
  start_2024_1000eur -> csv_atm_gbp_11750 [color="#FF6F00", penwidth=2.5, style=bold];
}
@enddot