@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config_group {
    label="Configuration";
    labeljust=l;
    style="dashed"; color="#888888";
    penwidth=1.5;
    subgraph cluster_config_accounts {
      label="Account Configuration";
      style=filled; fillcolor="#E3F2FD";
      rank=same;
      acct_bitvavo_csv [label="Bitvavo exchange\n(atomic CSV)", shape=box3d, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Bitvavo trading account — single-row atomic trades"];
      acct_kraken_csv [label="Kraken exchange\n(multi-row CSV)", shape=box3d, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Kraken trading account — split spend/receive rows linked by refid"];
      acct_triodos_csv [label="Triodos checking\n(EUR CSV)", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos checking account — imports from CSV"];
    }

    subgraph cluster_config_dir_paths {
      label="Directory Paths";
      style=filled; fillcolor="#BBDEFB";
      rank=same;
      dirp_default [label="Default dir paths", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard directory layout: import/{holder}/{bank}/{type}/{year}/"];
    }

    subgraph cluster_config_file_names {
      label="Filename Convention";
      style=filled; fillcolor="#90CAF9";
      rank=same;
      fnames_default [label="Default filenames", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard filename conventions for CSV, rules, and journal files"];
    }

    subgraph cluster_config_categorisation {
      label="Categorisation Config";
      style=filled; fillcolor="#64B5F6";
      rank=same;
      catcfg_default [label="Default categorisation", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard categorisation settings from config.yaml"];
    }

    subgraph cluster_config_matching_algo {
      label="Matching Algo Config";
      style=filled; fillcolor="#42A5F5";
      rank=same;
      malgo_default [label="Default matching algo", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard matching algorithm settings from config.yaml"];
    }

  }

  _skip_categories [label="Categories", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_matching_cfg [label="Matching Parameters", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_start_journal [label="Starting Journal", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_csv_txn [label="Bank CSV Transactions", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_receipt_img [label="Receipt Images", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_receipt_lbl_before [label="No label exists yet", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_receipt_lbl_tui [label="Label receipt in TUI", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_receipt_lbl_after [label="Receipt label output JSON", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_matching_out [label="Matching Outcome", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_journal_out [label="Journal Output", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  _skip_visualization [label="Visualisation", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  acct_bitvavo_csv -> dirp_default [style=invis];
  dirp_default -> fnames_default [style=invis];
  fnames_default -> catcfg_default [style=invis];
  catcfg_default -> malgo_default [style=invis];
  malgo_default -> _skip_categories [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_categories -> _skip_matching_cfg [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_matching_cfg -> _skip_start_journal [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_start_journal -> _skip_csv_txn [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_csv_txn -> _skip_receipt_img [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_receipt_img -> _skip_receipt_lbl_before [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_receipt_lbl_before -> _skip_receipt_lbl_tui [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_receipt_lbl_tui -> _skip_receipt_lbl_after [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_receipt_lbl_after -> _skip_matching_out [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_matching_out -> _skip_journal_out [style=dotted, color="#CCCCCC", arrowhead=none];
  _skip_journal_out -> _skip_visualization [style=dotted, color="#CCCCCC", arrowhead=none];

  acct_bitvavo_csv -> acct_triodos_csv [color="#E91E63", penwidth=2.5, style=solid];
  acct_kraken_csv -> acct_bitvavo_csv [color="#E91E63", penwidth=2.5, style=solid];
  acct_triodos_csv -> dirp_default [color="#E91E63", penwidth=2.5, style=solid];
  catcfg_default -> malgo_default [color="#E91E63", penwidth=2.5, style=solid];
  dirp_default -> fnames_default [color="#E91E63", penwidth=2.5, style=solid];
  fnames_default -> catcfg_default [color="#E91E63", penwidth=2.5, style=solid];
}
@enddot
