@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config {
    label="Configuration";
    style=filled; fillcolor="#E3F2FD";
    rank=same;
    cfg_1b1w [label="1 bank + 1 wallet", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos checking (EUR CSV) + EUR cash wallet (no CSV)"];
  }

  subgraph cluster_categories {
    label="Categories";
    style=filled; fillcolor="#E8F5E9";
    rank=same;
    cat_basic [label="basic categories", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="groceries:{ekoplaza,supermarket}, repairs:{bike}, withdrawl:{euro:{pound}}"];
  }

  subgraph cluster_matching_cfg {
    label="Matching Parameters";
    style=filled; fillcolor="#FFF3E0";
    rank=same;
    match_default [label="default (±2d, exact)", shape=component, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="days:2, amount_range:0, days_month_swap:true"];
  }

  subgraph cluster_start_journal {
    label="Starting Journal";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    start_2024_1000eur [label="2024: 1000 EUR", shape=note, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Opening balance: Assets:Triodos:Checking 1000 EUR"];
  }

  subgraph cluster_csv_txn {
    label="Bank CSV Transactions";
    style=filled; fillcolor="#E0F7FA";
    rank=same;
    csv_rounded_5000 [label="Triodos -50.00 EUR\n2025-01-15 ShopX", shape=cylinder, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Bank rounded 49.99 to 50.00"];
  }

  subgraph cluster_receipt_img {
    label="Receipt Images";
    style=filled; fillcolor="#FBE9E7";
    rank=same;
    img_rounded_shop [label="rounded_shop.jpg", shape=folder, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Receipt 49.99, bank shows 50.00"];
  }

  subgraph cluster_receipt_lbl {
    label="Receipt Labels (JSON)";
    style=filled; fillcolor="#FCE4EC";
    rank=same;
    lbl_rounded_shop [label="rounded_shop\nEUR 49.99 card", shape=tab, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Triodos account, bank will show 50.00"];
  }

  subgraph cluster_matching_out {
    label="Matching Outcome";
    style=filled; fillcolor="#FFF8E1";
    rank=same;
    out_widen_amount [label="WIDEN AMOUNT\n0 -> ±0.02", shape=diamond, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="No match at exact, user widens to ±0.02, finds match"];
  }

  subgraph cluster_journal_out {
    label="Journal Output";
    style=filled; fillcolor="#E8EAF6";
    rank=same;
    jrnl_rounded_shop [label="Expenses:Shopping\n50.00 EUR", shape=box, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Bank-rounded amount matched after widening amount"];
  }

  _skip_visualization [label="Visualisation", shape=plaintext, fontsize=9, fontcolor="#AAAAAA"];

  cfg_1b1w -> cat_basic [style=invis];
  cat_basic -> match_default [style=invis];
  match_default -> start_2024_1000eur [style=invis];
  start_2024_1000eur -> csv_rounded_5000 [style=invis];
  csv_rounded_5000 -> img_rounded_shop [style=invis];
  img_rounded_shop -> lbl_rounded_shop [style=invis];
  lbl_rounded_shop -> out_widen_amount [style=invis];
  out_widen_amount -> jrnl_rounded_shop [style=invis];
  jrnl_rounded_shop -> _skip_visualization [style=dotted, color="#CCCCCC", arrowhead=none];

  cat_basic -> match_default [color="#EF6C00", penwidth=2.5, style=dashed];
  cfg_1b1w -> cat_basic [color="#EF6C00", penwidth=2.5, style=dashed];
  csv_rounded_5000 -> img_rounded_shop [color="#EF6C00", penwidth=2.5, style=dashed];
  img_rounded_shop -> lbl_rounded_shop [color="#EF6C00", penwidth=2.5, style=dashed];
  lbl_rounded_shop -> out_widen_amount [color="#EF6C00", penwidth=2.5, style=dashed];
  match_default -> start_2024_1000eur [color="#EF6C00", penwidth=2.5, style=dashed];
  out_widen_amount -> jrnl_rounded_shop [color="#EF6C00", penwidth=2.5, style=dashed];
  start_2024_1000eur -> csv_rounded_5000 [color="#EF6C00", penwidth=2.5, style=dashed];
}
@enddot
