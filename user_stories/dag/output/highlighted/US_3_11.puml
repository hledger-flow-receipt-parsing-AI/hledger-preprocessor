@startdot
digraph userstory_dag {
  rankdir=TB;
  fontname="DejaVu Sans";
  node [fontname="DejaVu Sans", fontsize=10];
  edge [fontname="DejaVu Sans", fontsize=8];
  newrank=true;
  compound=true;

  subgraph cluster_config_group {
    label="Configuration";
    labeljust=l;
    style="dashed"; color="#888888";
    penwidth=1.5;
    subgraph cluster_config_accounts {
      label="Account Configuration";
      style=filled; fillcolor="#E3F2FD";
      rank=same;
      acct_bitvavo_csv [label="Bitvavo exchange\n(atomic CSV)", shape=box3d, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Bitvavo trading account — single-row atomic trades"];
      acct_btc_wallet [label="BTC digital\nwallet", shape=box3d, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="BTC digital wallet / exchange"];
      acct_eur_wallet [label="EUR physical\nwallet", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="EUR cash wallet — no CSV import"];
      acct_gbp_wallet [label="GBP physical\nwallet", shape=box3d, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="GBP cash wallet — foreign currency"];
      acct_gold_wallet [label="GOLD physical\nwallet", shape=box3d, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="GOLD physical asset wallet"];
      acct_ing_csv [label="ING checking\n(EUR CSV)", shape=box3d, penwidth=1.5, color="#CCCCCC", fontcolor="#999999", tooltip="ING checking account — imports from CSV"];
      acct_kraken_csv [label="Kraken exchange\n(multi-row CSV)", shape=box3d, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Kraken trading account — split spend/receive rows linked by refid"];
      acct_silver_wallet [label="SILVER physical\nwallet", shape=box3d, penwidth=2.0, color="#333333", fontcolor="#000000", tooltip="SILVER physical asset wallet"];
      acct_triodos_csv [label="Triodos checking\n(EUR CSV)", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Triodos checking account — imports from CSV"];
    }

    subgraph cluster_config_dir_paths {
      label="Directory Paths";
      style=filled; fillcolor="#BBDEFB";
      rank=same;
      dirp_default [label="Default dir paths", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard directory layout: import/{holder}/{bank}/{type}/{year}/"];
    }

    subgraph cluster_config_file_names {
      label="Filename Convention";
      style=filled; fillcolor="#90CAF9";
      rank=same;
      fnames_default [label="Default filenames", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard filename conventions for CSV, rules, and journal files"];
    }

    subgraph cluster_config_categorisation {
      label="Categorisation Config";
      style=filled; fillcolor="#64B5F6";
      rank=same;
      catcfg_default [label="Default categorisation", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard categorisation settings from config.yaml"];
    }

    subgraph cluster_config_matching_algo {
      label="Matching Algo Config";
      style=filled; fillcolor="#42A5F5";
      rank=same;
      malgo_default [label="Default matching algo", shape=box3d, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Standard matching algorithm settings from config.yaml"];
    }

  }

  subgraph cluster_categories {
    label="Categories";
    style=filled; fillcolor="#E8F5E9";
    rank=same;
    cat_basic [label="basic categories", shape=box3d, penwidth=3.0, color="#CCCCCC", fontcolor="#999999", tooltip="groceries:{ekoplaza,supermarket}, repairs:{bike}, withdrawl:{euro:{pound}}"];
    cat_extended [label="extended categories", shape=box3d, penwidth=1.5, color="#333333", fontcolor="#000000", tooltip="basic + dining, transport, bankfees, investments:{gold,silver}"];
    cat_with_income [label="categories + income", shape=box3d, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="basic + income:{salary,freelance}"];
  }

  subgraph cluster_matching_cfg {
    label="Matching Parameters";
    style=filled; fillcolor="#FFF3E0";
    rank=same;
    match_default [label="default (±2d, exact)", shape=component, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="days:2, amount_range:0, days_month_swap:true"];
    match_narrow [label="narrow (±1d, exact)", shape=component, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="days:1, amount_range:0 — initially too tight"];
    match_wide_both [label="wide both (±5d, ±0.05)", shape=component, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="days:5, amount_range:0.05 — triggers 15+ matches"];
    match_wide_date [label="wide date (±5d)", shape=component, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="days:5, amount_range:0"];
  }

  subgraph cluster_start_journal {
    label="Starting Journal";
    style=filled; fillcolor="#F3E5F5";
    rank=same;
    start_2024_1000eur [label="2024: 1000 EUR", shape=note, penwidth=3.0, color="#333333", fontcolor="#000000", tooltip="Opening balance: Assets:Triodos:Checking 1000 EUR"];
  }

  subgraph cluster_csv_txn {
    label="Bank CSV Transactions";
    style=filled; fillcolor="#E0F7FA";
    rank=same;
    csv_atm_gbp_11750 [label="Triodos -117.50 EUR\n2025-01-15 ATM London", shape=cylinder, penwidth=1.5, color="#CCCCCC", fontcolor="#999999", tooltip="Foreign ATM withdrawal: 100 GBP * 1.175"];
    csv_atm_gbp_23750_fee [label="Triodos -237.50 EUR\n2025-01-15 ATM London", shape=cylinder, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="200 GBP * 1.17 + 3.50 EUR fee"];
    csv_delayed_jan18 [label="Triodos -49.99 EUR\n2025-01-18 ShopX", shape=cylinder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Posted 3 days late (receipt dated Jan 15)"];
    csv_ekoplaza_4217_jan14 [label="Triodos -42.17 EUR\n2025-01-14 Ekoplaza", shape=cylinder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Same amount different day — ambiguous match candidate"];
    csv_ekoplaza_4217_jan15 [label="Triodos -42.17 EUR\n2025-01-15 Ekoplaza", shape=cylinder, penwidth=3.0, color="#CCCCCC", fontcolor="#999999", tooltip="Debit card purchase at Ekoplaza, exact date match"];
    csv_ekoplaza_4217_jan18 [label="Triodos -42.17 EUR\n2025-01-18 Ekoplaza", shape=cylinder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Same ekoplaza 42.17, bank posted 3 days late (receipt Jan 15)"];
    csv_ekoplaza_4300_jan16 [label="Triodos -43.00 EUR\n2025-01-16 Ekoplaza", shape=cylinder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Similar amount different day — ambiguous match candidate"];
    csv_gold_dealer_580 [label="Triodos -580.00 EUR\n2025-01-20 GoldDealer", shape=cylinder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="10g gold purchase at 58 EUR/g"];
    csv_rounded_5000 [label="Triodos -50.00 EUR\n2025-01-15 ShopX", shape=cylinder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Bank rounded 49.99 to 50.00"];
    csv_split_dinner_30 [label="Triodos -30.00 EUR\n2025-02-01 Restaurant", shape=cylinder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Card portion of 50 EUR split dinner"];
    csv_swapped_date [label="Triodos -25.00 EUR\n2025-05-01 BookShop", shape=cylinder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Receipt entered as 01-05 but meant 05-01"];
  }

  subgraph cluster_receipt_img {
    label="Receipt Images";
    style=filled; fillcolor="#FBE9E7";
    rank=same;
    img_atm_gbp [label="atm_london.jpg", shape=folder, penwidth=1.5, color="#CCCCCC", fontcolor="#999999", tooltip="ATM withdrawal slip, 100 GBP"];
    img_atm_gbp_fee [label="atm_london_fee.jpg", shape=folder, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="ATM withdrawal slip, 200 GBP + fee"];
    img_bike_repair [label="bike_repair.jpg", shape=folder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Bike repair receipt, cash"];
    img_coffee_cash [label="coffee_cash.jpg", shape=folder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Coffee receipt, paid cash"];
    img_delayed_shop [label="delayed_shop.jpg", shape=folder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Receipt dated Jan 15, bank posted Jan 18"];
    img_ekoplaza_card [label="ekoplaza_card.jpg", shape=folder, penwidth=3.0, color="#CCCCCC", fontcolor="#999999", tooltip="Ekoplaza receipt, paid by card"];
    img_gold [label="gold_dealer.jpg", shape=folder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Gold purchase receipt, 10g"];
    img_return_item [label="return_item.jpg", shape=folder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Receipt with bought + returned items"];
    img_rounded_shop [label="rounded_shop.jpg", shape=folder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Receipt 49.99, bank shows 50.00"];
    img_split_dinner [label="split_dinner.jpg", shape=folder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Restaurant receipt, split card+cash"];
    img_swapped_date [label="bookshop.jpg", shape=folder, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Receipt with ambiguous DD-MM date"];
  }

  subgraph cluster_receipt_lbl_before {
    label="No label exists yet";
    style=filled; fillcolor="#FFF0F3";
    rank=same;
    nolbl_atm_100gbp [label="atm_100gbp\n(no label)", shape=tab, penwidth=1.5, color="#CCCCCC", fontcolor="#999999", tooltip="No receipt label JSON exists yet for ATM withdrawal receipt"];
    nolbl_atm_200gbp_fee [label="atm_200gbp\n(no label)", shape=tab, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="No receipt label JSON exists yet for ATM withdrawal with fee"];
    nolbl_bike_cash [label="bike_repair\n(no label)", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="No receipt label JSON exists yet for bike repair"];
    nolbl_coffee_cash [label="coffee_cash\n(no label)", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="No receipt label JSON exists yet for coffee"];
    nolbl_delayed_shop [label="delayed_shop\n(no label)", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="No receipt label JSON exists yet for delayed shop"];
    nolbl_dinner_split [label="dinner_split\n(no label)", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="No receipt label JSON exists yet for dinner split"];
    nolbl_ekoplaza_card_eur [label="ekoplaza_card\n(no label)", shape=tab, penwidth=3.0, color="#CCCCCC", fontcolor="#999999", tooltip="No receipt label JSON exists yet for ekoplaza card receipt"];
    nolbl_gold_10g [label="gold_10g\n(no label)", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="No receipt label JSON exists yet for gold purchase"];
    nolbl_return_item [label="return_item\n(no label)", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="No receipt label JSON exists yet for return"];
    nolbl_rounded_shop [label="rounded_shop\n(no label)", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="No receipt label JSON exists yet for rounded shop"];
    nolbl_swapped_date [label="bookshop\n(no label)", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="No receipt label JSON exists yet for swapped date"];
  }

