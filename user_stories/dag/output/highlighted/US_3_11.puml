    tui_coffee_cash [label="TUI label\ncoffee_cash", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Label coffee receipt via TUI"];
    tui_delayed_shop [label="TUI label\ndelayed_shop", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Label delayed shop receipt via TUI"];
    tui_dinner_split [label="TUI label\ndinner_split", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Label dinner split receipt via TUI"];
    tui_ekoplaza_card_eur [label="TUI label\nekoplaza_card", shape=tab, penwidth=3.0, color="#CCCCCC", fontcolor="#999999", tooltip="Label ekoplaza card receipt via TUI based on image"];
    tui_gold_10g [label="TUI label\ngold_10g", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Label gold purchase receipt via TUI"];
    tui_return_item [label="TUI label\nreturn_item", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Label return receipt via TUI"];
    tui_rounded_shop [label="TUI label\nrounded_shop", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Label rounded shop receipt via TUI"];
    tui_swapped_date [label="TUI label\nbookshop", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Label swapped date receipt via TUI"];
  }

  subgraph cluster_receipt_lbl_after {
    label="Receipt label output JSON";
    style=filled; fillcolor="#F8BBD0";
    rank=same;
    lbl_atm_100gbp [label="atm_100gbp\nGBP 100 withdrawal", shape=tab, penwidth=1.5, color="#CCCCCC", fontcolor="#999999", tooltip="Triodos account, GBP withdrawal receipt"];
    lbl_atm_200gbp_fee [label="atm_200gbp\nGBP 200 + fee", shape=tab, penwidth=1.0, color="#333333", fontcolor="#000000", tooltip="Triodos account, GBP withdrawal with bank fee"];
