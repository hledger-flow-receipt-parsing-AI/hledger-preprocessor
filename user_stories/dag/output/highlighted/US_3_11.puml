    out_too_many_reduce [label="TOO MANY (15+)\nuser reduces scope", shape=diamond, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="User tightens margins, retries"];
    out_tui_widen_date [label="TUI WIDEN DATE\n±2d -> ±5d inline", shape=diamond, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Mismatch in TUI, user widens date range via inline matching CLI"];
