    lbl_rounded_shop [label="rounded_shop\nEUR 49.99 card", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Triodos account, bank will show 50.00"];
    lbl_swapped_date [label="bookshop\nEUR 25.00 card", shape=tab, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Triodos account, date entered as 01-05-2025"];
  }

  subgraph cluster_matching_out {
    label="Matching Outcome";
    style=filled; fillcolor="#FFF8E1";
    rank=same;
    out_asset_convert [label="ASSET CONVERT\ngold rate", shape=diamond, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="Physical asset conversion (GRAMS -> EUR)"];
    out_auto_1hit [label="AUTO-LINK\n1 match found", shape=diamond, penwidth=2.0, color="#CCCCCC", fontcolor="#999999", tooltip="Exact date+amount, no TUI needed"];
    out_correct_receipt [label="CORRECT RECEIPT\nedit inline", shape=diamond, penwidth=1.0, color="#CCCCCC", fontcolor="#999999", tooltip="User fixes receipt label, matcher retries"];
