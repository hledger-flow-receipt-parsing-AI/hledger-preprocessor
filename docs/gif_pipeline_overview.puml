@startuml gif_pipeline_overview
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName "DejaVu Sans"
skinparam defaultFontSize 11
skinparam packageStyle rectangle

top to bottom direction

skinparam component {
  BackgroundColor #E8F4FD
  BorderColor #2196F3
  FontColor #1565C0
}

skinparam database {
  BackgroundColor #FFF3E0
  BorderColor #FF9800
  FontColor #E65100
}

skinparam artifact {
  BackgroundColor #E8F5E9
  BorderColor #4CAF50
  FontColor #2E7D32
}

skinparam package {
  BackgroundColor #FAFAFA
  BorderColor #9E9E9E
}

title GIF Pipeline & Pre-commit Staleness Check

' ===========================================================================
'  ROW 1: Data Sources (left) | Orchestrator (right)
' ===========================================================================
together {
  package "Data Sources" as ds {
    database "config.yaml +\ncategories.yaml" as demo_config
    database "gif_config.yaml" as gif_config
    database "userstory_dag_data.yaml" as dag_yaml
    database "gif_dependencies.yaml" as gif_deps
    database "test/fixtures/" as fixtures
  }

  component "build_userstories.sh\n(orchestrator)" as build_sh
}

' ===========================================================================
'  ROW 2: Test Environment (left) | Per-GIF Recording (right)
' ===========================================================================
together {
  package "Test Environment" as env {
    component "setup_test_environment.py" as setup_env
    artifact "/tmp/hledger_demo/" as tmp_demo
  }

  package "Per-GIF Recording" as rec {
    component "generate.sh" as generate_sh
    component "common.sh" as common_sh
    component "install_coverage_pth.py" as pth_install
    component "asciinema rec" as asciinema
    component "Python demo script\n(pexpect)" as demo_script
    component "Sub-packages\n(core, config, csv-mapping,\nrules, receipt, ai)" as sub_pkgs
    artifact "recordings/<name>.cast" as cast_file
  }
}

' ===========================================================================
'  ROW 3: Post-processing (full width)
' ===========================================================================
package "Post-processing" as post {
  component "extract_coverage.py" as extract_cov
  artifact "_coverage.json\n(files + ast_hashes)" as cov_json
  component "cast_postprocess.py" as cast_pp
  component "agg -> gifsicle -> ffmpeg" as render_chain
  component "Marker extraction" as marker_extract
  artifact "_markers.json" as markers_json
  artifact "<name>.gif + <name>.mp4" as gif_mp4
}

' ===========================================================================
'  ROW 4: Stitch
' ===========================================================================
package "Stitch (optional)" as stitch_pkg {
  component "stitch_full_path.py" as stitch
  artifact "full_path.mp4" as full_path
}

' ===========================================================================
'  ROW 5: Site Generation (left) | Pre-commit Hook (right)
' ===========================================================================
together {
  package "Site Generation" as site {
    component "generate_userstory_artifacts.py" as gen_artifacts
    artifact "US_*.puml + US_*.png" as dag_pngs
    component "generate_site.py" as gen_site
    artifact "/tmp/site/" as site_output
  }

  package "Pre-commit Hook\n(gif-staleness-hook)" as hook_pkg {
    component "check-gif-staleness.py" as hook
    component "AST hash comparison" as cov_check
    component "YAML pattern match" as yaml_check
    component "Artifact check" as artifact_check
    artifact "PASS / WARN / BLOCK" as hook_result
  }
}

' ===========================================================================
'  CONNECTIONS
' ===========================================================================

' Data sources -> test env
demo_config --> setup_env
fixtures --> setup_env
setup_env --> tmp_demo

' Orchestrator dispatches
build_sh --> setup_env
build_sh --> generate_sh
build_sh --> gen_artifacts
build_sh --> gen_site

' Recording flow
generate_sh --> common_sh
gif_config --> common_sh
common_sh --> pth_install
common_sh --> asciinema
asciinema --> demo_script
demo_script --> sub_pkgs
tmp_demo --> demo_script
asciinema --> cast_file

' Post-processing
common_sh --> extract_cov
extract_cov --> cov_json
common_sh --> cast_pp
cast_file --> render_chain
render_chain --> gif_mp4
cast_file --> marker_extract
marker_extract --> markers_json

' Stitch
gif_mp4 --> stitch
markers_json --> stitch
stitch --> full_path

' Site generation
dag_yaml --> gen_artifacts
gen_artifacts --> dag_pngs
dag_yaml --> gen_site
gif_mp4 --> gen_site
markers_json --> gen_site
full_path --> gen_site
gen_site --> site_output

' Pre-commit hook
cov_json ..> cov_check
gif_deps ..> yaml_check
hook --> cov_check
hook --> yaml_check
hook --> artifact_check
cov_check --> hook_result
yaml_check --> hook_result
artifact_check --> hook_result

@enduml
