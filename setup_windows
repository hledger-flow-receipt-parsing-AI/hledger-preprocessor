#!/usr/bin/env python3
"""One-command Windows setup for the receipt-labelling TUI.

Run from a normal (non-admin) Command Prompt or PowerShell:

    py setup_windows

(or ``python setup_windows`` if the ``py`` launcher is missing).

Needs only a 64-bit Python >= 3.10 with tkinter (the python.org and
Microsoft Store builds both include it). No admin rights, conda or git
needed: the sibling repos are downloaded as GitHub zip archives and
installed into a private venv under %LOCALAPPDATA%\\hledger-labeller.
If the managed laptop blocks running a venv's python.exe (AppLocker), the
script falls back to ``pip install --user`` with the system Python.

Afterwards, label receipts with:

    %LOCALAPPDATA%\\hledger-labeller\\label_receipts.cmd config.yaml

Options: --ref <branch> (default main), --dir <install dir>, --with-ai.
"""

from __future__ import annotations

import argparse
import io
import os
import shutil
import subprocess
import sys
import urllib.request
import zipfile
from pathlib import Path

GITHUB_ORG = "https://github.com/hledger-flow-receipt-parsing-AI"
# Dependency order; hledger-preprocessor is last because it pins the others.
REPOS = [
    "hledger-core",
    "hledger-config",
    "hledger-csv-mapping",
    "hledger-receipt-processing",
    "hledger-rules",
    "tui-image-labeller",
    "hledger-preprocessor",
]
# Imported by the labelling path but not declared in any pyproject/setup.cfg.
# urwid >= 2.6 is the first release with a native Windows console backend;
# opencv-python (not -headless) is needed for the rotate/crop windows.
EXTRA_DEPS = [
    "urwid>=2.6",
    "opencv-python",
    "screeninfo",
    "matplotlib",
    "numpy",
    "Pillow",
]
MSVC_URL = "https://visualstudio.microsoft.com/visual-cpp-build-tools/"
# Gitignored real files that are imported at startup; CI swaps in stubs.
CI_STUBS = [
    "src/hledger_preprocessor/categorisation/rule_based/private_logic.py",
    "src/hledger_preprocessor/checks/check_categorisation_overlap.py",
]

LAUNCHER = r"""@echo off
rem Generated by hledger-preprocessor/setup_windows.
chcp 65001 >nul
rem The code opens text files without an explicit encoding; force UTF-8.
set PYTHONUTF8=1
set "TUI_LABELLER_LOG=%~dp0tui_labeller.log"
set ARGS=%*
if "%~1"=="" set /p "CFG=Path to your config.yaml: "
rem Drag-and-drop into the prompt adds quotes; strip them, then re-quote.
if "%~1"=="" set ARGS="%CFG:"=%"
"{python}" -m hledger_preprocessor --tui-label-receipts ^
    {ai_flag}--config %ARGS%
"""


def step(msg: str) -> None:
    print(f"\n==> {msg}", flush=True)


def fail(msg: str) -> None:
    print(f"\nERROR: {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd: list, **kwargs) -> subprocess.CompletedProcess:
    print("    $ " + " ".join(str(c) for c in cmd), flush=True)
    return subprocess.run([str(c) for c in cmd], **kwargs)


def check_python() -> None:
    step(f"Checking Python ({sys.executable})")
    if sys.version_info < (3, 10):
        fail(f"Python >= 3.10 required, found {sys.version.split()[0]}.")
    if sys.maxsize <= 2**32:
        fail("A 64-bit Python is required (opencv wheels).")
    try:
        import tkinter

        tkinter.Tcl()
    except Exception as exc:  # pylint: disable=broad-except
        fail(
            "tkinter is missing or broken; the receipt image window needs "
            "it. Install Python from python.org (tick 'tcl/tk') or the "
            f"Microsoft Store. Detail: {exc}"
        )
    if sys.platform != "win32":
        print("    (not Windows; continuing anyway for testing)")


def has_msvc() -> bool:
    if shutil.which("cl"):
        return True
    # vswhere ships with every Visual Studio / Build Tools 2017+ install.
    vswhere = (
        Path(os.environ.get("ProgramFiles(x86)", r"C:\Program Files (x86)"))
        / "Microsoft Visual Studio"
        / "Installer"
        / "vswhere.exe"
    )
    if not vswhere.exists():
        return False
    result = subprocess.run(
        [
            str(vswhere),
            "-latest",
            "-products",
            "*",
            "-requires",
            "Microsoft.VisualStudio.Component.VC.Tools.x86.x64",
            "-property",
            "installationPath",
        ],
        capture_output=True,
        text=True,
    )
    return bool(result.stdout.strip())


def check_msvc() -> None:
    """Pip needs MSVC >= 14.0 for any dependency without a Windows wheel."""
    if sys.platform != "win32":
        return
    step("Checking for Microsoft C++ Build Tools")
    while not has_msvc():
        print(
            "    Microsoft Visual C++ 14.0 or greater was not found. Some\n"
            "    packages may need it to install. Download it from:\n\n"
            f"        {MSVC_URL}\n\n"
            "    In the installer, tick 'Desktop development with C++'.\n"
            "    Installing needs admin rights: on a managed laptop look\n"
            "    for 'Visual Studio Build Tools' in Software Center, or\n"
            "    ask IT.\n"
        )
        try:
            answer = input(
                "    Press Enter once installed to re-check, or type 'skip'"
                " to try without it: "
            )
        except EOFError:
            fail(f"Install Microsoft C++ Build Tools from {MSVC_URL}")
        if answer.strip().lower() == "skip":
            return
    print("    found")


def download_sources(ref: str, src_dir: Path) -> dict:
    step(f"Downloading sources (ref '{ref}') into {src_dir}")
    if src_dir.exists():
        shutil.rmtree(src_dir)
    src_dir.mkdir(parents=True)
    paths = {}
    for repo in REPOS:
        url = f"{GITHUB_ORG}/{repo}/archive/refs/heads/{ref}.zip"
        print(f"    {url}", flush=True)
        try:
            # Bandit B310 is moot: url always starts with the https GITHUB_ORG.
            with urllib.request.urlopen(url, timeout=120) as resp:  # nosec
                data = resp.read()
        except Exception as exc:  # pylint: disable=broad-except
            fail(f"Could not download {url}: {exc}")
        with zipfile.ZipFile(io.BytesIO(data)) as zf:
            top = zf.namelist()[0].split("/")[0]
            zf.extractall(src_dir)
        paths[repo] = src_dir / top
    return paths


def install_ci_stubs(preprocessor_dir: Path) -> None:
    step("Installing stubs for gitignored private modules")
    for rel in CI_STUBS:
        target = preprocessor_dir / rel
        stub = target.with_name(target.name + ".ci_stub")
        if target.exists():
            continue
        if not stub.exists():
            fail(f"Neither {target} nor its stub {stub} exists.")
        shutil.copyfile(stub, target)
        print(f"    {rel}")


def make_venv(venv_dir: Path) -> Path | None:
    """Returns the venv's python, or None if the laptop won't run it."""
    step(f"Creating virtual environment {venv_dir}")
    if not (venv_dir / "pyvenv.cfg").exists():
        result = run([sys.executable, "-m", "venv", venv_dir])
        if result.returncode != 0:
            print("    venv creation failed; falling back to --user install")
            return None
    sub = "Scripts" if os.name == "nt" else "bin"
    exe = "python.exe" if os.name == "nt" else "python"
    venv_python = venv_dir / sub / exe
    try:
        if run([venv_python, "-c", "pass"]).returncode == 0:
            return venv_python
    except OSError as exc:
        print(f"    cannot execute venv python ({exc})")
    print("    venv python is blocked; falling back to --user install")
    return None


def pip_install(python: Path, user: bool, args: list) -> bool:
    cmd = [python, "-m", "pip", "install", "--disable-pip-version-check"]
    if user:
        cmd.append("--user")
    return run(cmd + args).returncode == 0


def write_launcher(install_dir: Path, python: Path, with_ai: bool) -> Path:
    launcher = install_dir / "label_receipts.cmd"
    launcher.write_text(
        LAUNCHER.format(python=python, ai_flag="" if with_ai else "--skip-ai "),
        encoding="utf-8",
    )
    return launcher


def smoke_test(python: Path) -> None:
    step("Checking that everything imports")
    code = (
        "import urwid, cv2, matplotlib, screeninfo, tkinter;"
        "import hledger_preprocessor.__main__ as m;"
        "import tui_labeller.tuis.urwid.ask_urwid_receipt;"
        "print('    urwid', urwid.__version__, '- OK')"
    )
    # __main__ only defines main() behind a __name__ guard, so importing it
    # exercises the full import graph without starting anything.
    if run([python, "-c", code]).returncode != 0:
        fail("Import check failed; see the traceback above.")


def main() -> None:
    parser = argparse.ArgumentParser(description=__doc__.split("\n")[0])
    parser.add_argument("--ref", default="main", help="git branch to install")
    parser.add_argument(
        "--dir",
        default=os.path.join(
            os.environ.get("LOCALAPPDATA", str(Path.home())),
            "hledger-labeller",
        ),
        help="install directory",
    )
    parser.add_argument(
        "--with-ai",
        action="store_true",
        help="keep AI suggestions on (needs hledger-ai + a running Ollama)",
    )
    args = parser.parse_args()
    install_dir = Path(args.dir)
    install_dir.mkdir(parents=True, exist_ok=True)

    check_python()
    check_msvc()
    sources = download_sources(args.ref, install_dir / "src")
    install_ci_stubs(sources["hledger-preprocessor"])

    venv_python = make_venv(install_dir / "venv")
    user = venv_python is None
    python = venv_python or Path(sys.executable)

    step("Installing packages (this takes a few minutes)")
    pip_install(python, user, ["--upgrade", "pip"])
    # One resolver run so hledger-preprocessor's 'hledger-core>=0.1.0' etc.
    # are satisfied by the local sources instead of being looked up on PyPI.
    # --prefer-binary picks an older release with a Windows wheel over
    # compiling the newest one from source, so MSVC is rarely needed.
    if not pip_install(
        python,
        user,
        ["--prefer-binary"] + [str(sources[r]) for r in REPOS] + EXTRA_DEPS,
    ):
        hint = ""
        if sys.platform == "win32" and not has_msvc():
            hint = (
                " If it says 'Microsoft Visual C++ 14.0 or greater is "
                f"required', install it from {MSVC_URL} and re-run."
            )
        fail("pip install failed; see the output above." + hint)

    smoke_test(python)
    launcher = write_launcher(install_dir, python, args.with_ai)

    step("Done")
    print(
        f"    Label receipts with:\n\n"
        f'        "{launcher}" C:\\path\\to\\config.yaml\n\n'
        "    Use Windows Terminal (or a Windows 10+ console) for the TUI.\n"
        "    Re-run this script to update to the latest code."
    )


if __name__ == "__main__":
    main()
