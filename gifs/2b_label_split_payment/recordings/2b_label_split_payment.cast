[10.159071, "o", "\u001b[1;37m$ jq '.net_bought_items.account_transactions[] | {bank: .account.bank, type: .account.account_type, currency: .currency, amount: .tendered_amount_out}' /tmp/label_split_demo_uok5eedv/receipt_labels/da3902fb202c97f923e4ccc75c93b1982dbbdcfcbdce464658aa58d565c430d4/receipt_image_to_obj_label.json\u001b[0m\r\n\r\n"]
[10.461733, "o", "{\r\n  \"bank\": \"triodos\",\r\n  \"type\": \"checking\",\r\n  \"currency\": \"EUR\",\r\n  \"amount\": 30.0\r\n}\r\n{\r\n  \"bank\": \"wallet\",\r\n  \"type\": \"physical\",\r\n  \"currency\": \"EUR\",\r\n  \"amount\": 20.0\r\n}\r\n\r\n"]
[12.462511, "o", "\u001b[1;33m  Account 1: Triodos checking — 30.00 EUR (card)\u001b[0m\r\n\u001b[1;33m  Account 2: EUR wallet — 20.00 EUR (cash)\u001b[0m\r\n\u001b[1;33m  Total: 50.00 EUR\u001b[0m\r\n\r\n\u001b[37m  During matching (Step 3), only the card portion (30 EUR) is matched\u001b[0m\r\n\u001b[37m  to a bank CSV transaction. The cash portion (20 EUR) is recorded\u001b[0m\r\n\u001b[37m  directly as a wallet expense.\u001b[0m\r\n\r\n"]
[15.462946, "o", "\r\n\u001b[1;32m✓ Split-payment receipt labelled successfully!\u001b[0m\r\n\r\n"]
[16.463113, "o", "\u001b[1;36mNext step:\u001b[0m Run matching (Step 3) to link card portion to bank CSV\r\n\r\n"]
