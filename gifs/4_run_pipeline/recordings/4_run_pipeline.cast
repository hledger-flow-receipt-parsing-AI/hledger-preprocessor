[1.008991, "o", "\u001b[2J\u001b[H\u001b[2m@@NODE:acct_triodos_csv@@\u001b[0m\r\n\u001b[2m@@NODE:cat_basic@@\u001b[0m\r\n\u001b[2m@@NODE:match_default@@\u001b[0m\r\n\u001b[2m@@NODE:start_2024_1000eur@@\u001b[0m\r\n\r\n\u001b[1;33m══════════════════════════════════════════════════════════════════════\u001b[0m\r\n\u001b[1;33m  hledger-preprocessor: Full Pipeline Demo\u001b[0m\r\n\u001b[1;33m══════════════════════════════════════════════════════════════════════\u001b[0m\r\n"]
