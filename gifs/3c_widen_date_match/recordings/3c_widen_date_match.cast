[0.052482, "o", "\u001b[2J\u001b[H\r\n\u001b[1;33m══════════════════════════════════════════════════════════════════════\u001b[0m\r\n\u001b[1;33m  Step 3c: Widen Date Range (Delayed Posting)\u001b[0m\r\n\u001b[1;33m══════════════════════════════════════════════════════════════════════\u001b[0m\r\n\r\n"]
[1.052801, "o", "\u001b[37mThis demo shows matching when the bank posts a transaction days after purchase.\u001b[0m\r\n\u001b[37mReceipt: Jan 15 | CSV: Jan 18 | Default margin: ±2 days → miss → widen → match\u001b[0m\r\n\r\n"]
