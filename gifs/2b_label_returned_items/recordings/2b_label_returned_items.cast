[10.670568, "o", "{\r\n  \"account_transactions\": [\r\n    {\r\n      \"account\": {\r\n        \"account_holder\": \"at\",\r\n        \"account_type\": \"checking\",\r\n        \"bank\": \"triodos\",\r\n        \"base_currency\": \"EUR\"\r\n      },\r\n      \"change_returned\": 0,\r\n      \"currency\": \"EUR\",\r\n      \"tendered_amount_out\": 25.0\r\n    }\r\n  ],\r\n  \"category\": null,\r\n  \"description\": \"clothing:store\",\r\n  \"group_discount\": 0,\r\n  \"quantity\": 1,\r\n  \"round_amount\": null,\r\n  \"tax_per_unit\": 0,\r\n  \"the_date\": \"2025-03-01T11:00:00\",\r\n  \"unit_price\": 25.0\r\n}\r\n\r\n"]
[12.671419, "o", "\r\n\u001b[1;36m────────────────────────────────────────────────────────────\u001b[0m\r\n\u001b[1;36m  Net Amount Calculation\u001b[0m\r\n\u001b[1;36m────────────────────────────────────────────────────────────\u001b[0m\r\n\r\n"]
[13.171883, "o", "\u001b[1;33m  Bought: 3 items x 25.00 EUR = 75.00 EUR\u001b[0m\r\n\u001b[1;33m  Returned: 1 item x 25.00 EUR = 25.00 EUR\u001b[0m\r\n\u001b[1;32m  Net amount: 75.00 - 25.00 = 50.00 EUR\u001b[0m\r\n\r\n\u001b[37m  During matching (Step 3), only the net amount (50.00 EUR) is\u001b[0m\r\n\u001b[37m  searched in the bank CSV. The bank statement shows the net\u001b[0m\r\n\u001b[37m  charge, not the gross amount.\u001b[0m\r\n\r\n"]
[16.171993, "o", "\r\n\u001b[1;32m✓ Receipt with returned items labelled successfully!\u001b[0m\r\n\r\n"]
[17.172387, "o", "\u001b[1;36mNext step:\u001b[0m Run matching (Step 3) to link net amount to bank CSV\r\n\r\n"]
