[7.86701, "o", "{\r\n  \"account_transactions\": [\r\n    {\r\n      \"account\": {\r\n        \"account_holder\": \"at\",\r\n        \"account_type\": \"checking\",\r\n        \"bank\": \"triodos\",\r\n        \"base_currency\": \"EUR\"\r\n      },\r\n      \"change_returned\": 0,\r\n      \"currency\": \"EUR\",\r\n      \"tendered_amount_out\": 75.0\r\n    }\r\n  ],\r\n  \"category\": null,\r\n  \"description\": \"clothing:store\",\r\n  \"group_discount\": 0,\r\n  \"quantity\": 3,\r\n  \"round_amount\": null,\r\n  \"tax_per_unit\": 0,\r\n  \"the_date\": \"2025-03-01T11:00:00\",\r\n  \"unit_price\": 25.0\r\n}\r\n\r\n"]
