[7.830059, "o", "{\r\n  \"account_transactions\": [\r\n    {\r\n      \"account\": {\r\n        \"account_holder\": \"at\",\r\n        \"account_type\": \"checking\",\r\n        \"bank\": \"triodos\",\r\n        \"base_currency\": \"EUR\"\r\n      },\r\n      \"change_returned\": 0,\r\n      \"currency\": \"POUND\",\r\n      \"tendered_amount_out\": 100.0\r\n    }\r\n  ],\r\n  \"category\": null,\r\n  \"description\": \"cash:atm_withdrawal\",\r\n  \"group_discount\": 0,\r\n  \"quantity\": 1,\r\n  \"round_amount\": null,\r\n  \"tax_per_unit\": 0,\r\n  \"the_date\": \"2025-03-20T14:00:00\",\r\n  \"unit_price\": null\r\n}\r\n\r\n"]
[9.83018, "o", "\u001b[1;33m  Key: currency = POUND (not EUR)\u001b[0m\r\n\u001b[1;33m  Key: tendered_amount_out = 100.00 (GBP)\u001b[0m\r\n\u001b[1;33m  Key: account.base_currency = EUR (bank account is EUR)\u001b[0m\r\n\r\n\u001b[37m  During matching (Step 3), the algorithm will detect the currency\u001b[0m\r\n\u001b[37m  mismatch and prompt for a conversion rate.\u001b[0m\r\n\r\n"]
